{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://truss.md/spec/0.1/schemas/feature.schema.json",
  "title": "feature: What one capability of the product does today",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/doc"
    },
    {
      "type": "object",
      "required": [],
      "properties": {
        "type": {
          "const": "feature"
        },
        "id": {
          "type": "string",
          "pattern": "^FEAT-[0-9]{4,}$"
        },
        "status": {
          "enum": [
            "planned",
            "live",
            "deprecated",
            "removed",
            "dropped"
          ]
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?![/~\\\\])(?![A-Za-z]:)(?!(?:.*/)?\\.\\.(?:/|$))[^\\\\]+$"
          }
        }
      }
    }
  ]
}
