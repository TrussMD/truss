{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://truss.md/spec/0.1/schemas/research.schema.json",
  "title": "research: What we learned, as numbered findings",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/doc"
    },
    {
      "type": "object",
      "required": [
        "method"
      ],
      "properties": {
        "type": {
          "const": "research"
        },
        "id": {
          "type": "string",
          "pattern": "^RES-[0-9]{4,}$"
        },
        "status": {
          "enum": [
            "draft",
            "published"
          ]
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "examples": [
            "interviews",
            "survey",
            "analytics",
            "experiment",
            "market-scan",
            "competitor-review",
            "due-diligence",
            "deep-research"
          ]
        }
      }
    }
  ]
}
