{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://truss.md/spec/0.1/schemas/common.schema.json",
  "title": "Fields every Truss doc shares",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*-[0-9]{4,}$"
    },
    "docRef": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*-[0-9]{4,}(#(F|AC|Q)[0-9]+)?$",
      "description": "An ID, optionally with a label: DEC-0002, RES-0001#F3"
    },
    "ticketRef": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^https?://\\S+$"
        },
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*:\\S+$"
        }
      ],
      "description": "A ticket in another system: a URL, or source:id such as intercom:2291"
    },
    "ticketObject": {
      "type": "object",
      "required": [
        "ref"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/ticketRef"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "carriesItem": {
      "anyOf": [
        {
          "$ref": "#/$defs/docRef"
        },
        {
          "$ref": "#/$defs/ticketRef"
        },
        {
          "$ref": "#/$defs/ticketObject"
        }
      ]
    },
    "idOrList": {
      "anyOf": [
        {
          "$ref": "#/$defs/id"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1
        }
      ]
    },
    "person": {
      "type": "string",
      "pattern": "^@[A-Za-z0-9][A-Za-z0-9._-]*$",
      "description": "A person: \"@handle\""
    },
    "actor": {
      "anyOf": [
        {
          "$ref": "#/$defs/person"
        },
        {
          "type": "string",
          "pattern": "^agent:[a-z0-9][a-z0-9._-]*$"
        }
      ],
      "description": "A person (\"@handle\") or an agent (agent:name)"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "doc": {
      "type": "object",
      "required": [
        "type",
        "id",
        "title",
        "status",
        "date"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string"
        },
        "date": {
          "$ref": "#/$defs/date"
        },
        "owner": {
          "$ref": "#/$defs/person"
        },
        "carries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/carriesItem"
          }
        },
        "related": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/docRef"
          }
        },
        "visibility": {
          "enum": [
            "internal",
            "public"
          ],
          "default": "internal"
        }
      }
    }
  }
}
